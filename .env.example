# Public application URL, used for session cookies and origin checks.
APP_URL=http://localhost:3000

# Authorized owner identity
OWNER_EMAIL=nofabusinessconsulting@gmail.com

# Firebase web app config (these values are public in the browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=saasscout-ai-pilot.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=saasscout-ai-pilot
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin (server only; never expose to the browser)
FIREBASE_PROJECT_ID=saasscout-ai-pilot
FIREBASE_SERVICE_ACCOUNT_JSON=

# Discovery
EXA_API_KEY=

# Gmail OAuth and sending. Keep MAIL_MODE=mock until OAuth is configured and tested.
MAIL_MODE=mock
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/gmail/callback
OAUTH_TOKEN_ENCRYPTION_KEY=
GMAIL_SEND_MODE=test
GMAIL_TEST_RECIPIENT=

STORE_DRIVER=firestore
