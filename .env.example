# Public application URL (no trailing slash)
APP_URL=http://localhost:3000

# Owner identity and pilot authentication
OWNER_EMAIL=nofabusinessconsulting@gmail.com
AUTH_MODE=mock
SESSION_SECRET=replace-with-at-least-32-random-characters
MOCK_OWNER_CODE=replace-with-a-pilot-only-code

# Mail mode. Keep mock until Gmail OAuth is implemented and approved.
MAIL_MODE=mock

# Store driver. json is local/mock only; Firestore is a later milestone.
STORE_DRIVER=json
DATA_FILE=./.data/store.json

