{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": ".test-dist",
    "noEmit": false,
    "incremental": false,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["lib/**/*.ts", "tests/**/*.test.ts"],
  "exclude": ["node_modules", ".next", "app"]
}
